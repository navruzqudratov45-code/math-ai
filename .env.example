# Copy this file to .env.local and replace the placeholders.
OPENROUTER_API_KEY=sk-or-v1-replace-me
OPENROUTER_MODEL=provider/vision-capable-model
# Optional: canonical URL sent to OpenRouter for app identification.
OPENROUTER_SITE_URL=https://mathai.toshniyozov.dev
# Public application URL used for redirects and email links.
APP_URL=https://mathai.toshniyozov.dev
# Canonical owner administrator email.
ADMIN_EMAIL=navruzqudratov45@gmail.com
# SQLite file path (defaults to ./data/mathai.sqlite locally, /data/mathai.sqlite in Docker/Railway).
# MATHAI_DB_PATH=/data/mathai.sqlite
# Global daily AI request cap across all users to protect OpenRouter budget (default: 2000).
MATHAI_GLOBAL_DAILY_LIMIT=2000
# Password reset email via Resend (optional until reset delivery is enabled).
# RESEND_API_KEY=re_replace_me
# AUTH_FROM_EMAIL=MathAI <no-reply@toshniyozov.dev>
# Optional: absolute path to a Python interpreter if the project .venv is not used.
# SYMPY_PYTHON=/app/.venv/bin/python
